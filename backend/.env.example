# Local development settings for the API/worker (copy to backend/.env). Never commit real secrets.
CMMS_ENVIRONMENT=development
CMMS_DATABASE_URL=postgresql+psycopg://cmms_app:dev_app_pw@localhost:5432/cmms
CMMS_MIGRATION_DATABASE_URL=postgresql+psycopg://cmms_owner:dev_owner_pw@localhost:5432/cmms
CMMS_COOKIE_SECURE=true
CMMS_SESSION_TTL_HOURS=12
CMMS_SESSION_IDLE_MINUTES=120
CMMS_STORAGE_BACKEND=local
CMMS_STORAGE_LOCAL_PATH=./var/storage
CMMS_MAX_UPLOAD_MB=25
CMMS_SMTP_HOST=
CMMS_SMTP_FROM=
CMMS_LOG_JSON=true
