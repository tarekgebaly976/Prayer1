# Single public origin. Caddy obtains and renews TLS certificates automatically for {$CMMS_DOMAIN}.
# For local runs CMMS_DOMAIN=localhost uses Caddy's internal CA (trust it or accept the warning).
{$CMMS_DOMAIN:localhost} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	# Upload limit slightly above the API's own limit (CMMS_MAX_UPLOAD_MB).
	request_body {
		max_size 30MB
	}
	handle /api/* {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy web:3000
	}
	log {
		output stdout
		format json
	}
}
