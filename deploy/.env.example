# Copy to deploy/.env (never commit the real file). Generate strong values, e.g. `openssl rand -base64 32`.
CMMS_ENVIRONMENT=production
CMMS_DOMAIN=cmms.example.com
CMMS_OWNER_DB_PASSWORD=change-me
CMMS_APP_DB_PASSWORD=change-me-too
# Object storage: local (docker volume) or s3
CMMS_STORAGE_BACKEND=local
CMMS_S3_BUCKET=
CMMS_S3_REGION=
# Email notifications stay disabled until these are set
CMMS_SMTP_HOST=
CMMS_SMTP_PORT=587
CMMS_SMTP_USER=
CMMS_SMTP_PASSWORD=
CMMS_SMTP_FROM=
